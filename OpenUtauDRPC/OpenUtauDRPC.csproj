<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUtau\OpenUtau.csproj" />
    <ProjectReference Include="..\OpenUtau.Core\OpenUtau.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyOutput" AfterTargets="Publish">
    <Move
      SourceFiles="$(PublishDir)\OpenUtauDRPC.dll;$(PublishDir)\DiscordRPC.dll"
      DestinationFolder="$(OutputPath)/OpenUtauDRPC" />
  </Target>

</Project>
